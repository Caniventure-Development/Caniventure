{
  "name": "caniventure",
  "type": "module",
  "version": "0.0.1-alpha0.1",
  "description": "The cannibalistic economy bot",
  "main": "src/index.ts",
  "scripts": {
    "check": "biome check .",
    "commit": "cz",
    "commit:all": "git add . && cz",
    "format": "biome format .",
    "lint": "biome lint .",
    "mikro-orm": "mikro-orm-esm",
    "prepare": "husky",
    "setup": "bun run setup.ts",
    "start": "bun run src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@commitlint/cz-commitlint": "^20.4.1",
    "@commitlint/types": "^20.4.0",
    "@mikro-orm/cli": "^6.6.4",
    "@types/bun": "latest",
    "@types/common-tags": "^1.8.4",
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "inquirer": "9",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@discord-ui-kit/seyfert": "npm:@jsr/discord-ui-kit__seyfert@0.0.8",
    "@luca/cases": "npm:@jsr/luca__cases",
    "@mikro-orm/core": "^6.6.4",
    "@mikro-orm/postgresql": "^6.6.4",
    "@mikro-orm/reflection": "^6.6.4",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@sapphire/discord-utilities": "^4.0.0",
    "@sapphire/result": "^2.8.0",
    "@sapphire/stopwatch": "^1.5.4",
    "@sapphire/timestamp": "^1.0.5",
    "@sapphire/utilities": "^3.18.2",
    "@slipher/cooldown": "https://pkg.pr.new/tiramisulabs/extra/@slipher/cooldown@91dc6b4",
    "common-tags": "^1.8.2",
    "dotenv": "^17.2.3",
    "picocolors": "^1.1.1",
    "seyfert": "^4.2.0",
    "statfert": "^0.0.2",
    "ts-morph": "^27.0.2"
  },
  "imports": {
    "#base/*": "./src/*",
    "#components/*": "./src/components/*",
    "#entities/*": "./entities/*",
    "#handlers/*": "./src/handlers/*",
    "#subcommands/*": "./src/subcommands/*",
    "#utilities/*": "./src/utilities/*"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/@commitlint/cz-commitlint"
    }
  }
}
