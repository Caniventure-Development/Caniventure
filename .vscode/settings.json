{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.idea/": true,
    "**/cache/": true,
    "**/node_modules/": true,
    "**/temp/": true
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },
  "markdownlint.config": {
    "MD041": false
  }
}
